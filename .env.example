# Supabase — configuración pública (segura para el navegador).
# Copia este archivo a .env.local y rellena los valores del proyecto.
#
# Proyecto -> Settings -> API:
# URL completa del proyecto, por ejemplo https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Preferida en proyectos nuevos (Supabase la muestra como sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatible con proyectos existentes; usa una sola de las dos claves públicas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA expongas la service_role: no debe llevar el prefijo NEXT_PUBLIC_ ni
# incluirse en el bundle del cliente. Solo la usa el endpoint de solicitudes.
SUPABASE_SECRET_KEY=
# Secreto aleatorio de al menos 32 bytes para HMAC de rate limit/idempotencia.
PAWPASS_ADOPTION_RATE_SECRET=
# Correo verificado en Resend para entregar las solicitudes.
RESEND_API_KEY=
PAWPASS_ADOPTION_FROM_EMAIL=
